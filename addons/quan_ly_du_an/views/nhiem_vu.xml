
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_nhiem_vu_form" model="ir.ui.view">
        <field name="name">nhiem.vu.form</field>
        <field name="model">nhiem_vu</field>
        <field name="arch" type="xml">
            <form string="Nhiệm vụ">
                <sheet>

                    <group>
                        <group>
                            <field name="ten_nhiem_vu"/>
                            <field name="du_an_id"/>
                            <field name="trang_thai"/>
                            <field name="muc_uu_tien"/>
                        </group>

                        <group>
                            <field name="ngay_bat_dau"/>
                            <field name="han_chot"/>
                            <field name="so_ngay_thuc_hien" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="mo_ta"/>
                    </group>

                    <notebook>

                        <!-- NGƯỜI PHỤ TRÁCH -->
                        <page string="Người phụ trách">
                            <field name="nguoi_phu_trach_id"
                                   widget="many2many_tags"
                                   readonly="1"/>
                            <field name="so_luong_nguoi_phu_trach"
                                   readonly="1"/>
                        </page>

                        <!-- NGƯỜI THỰC HIỆN -->
                        <page string="Người thực hiện">
                            <field name="nguoi_thuc_hien_id"
                                   widget="many2many_tags"/>
                            <field name="so_luong_nguoi_thuc_hien"
                                   readonly="1"/>
                        </page>

                        <!-- TIẾN ĐỘ -->
                        <page string="Tiến độ">
                            <field name="tien_do_ids"
                                   context="{'default_nhiem_vu_id': active_id}">
                                <tree editable="bottom">
                                    <field name="ngay_cap_nhat"/>
                                    <field name="ghi_chu"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_nhiem_vu_tree" model="ir.ui.view">
        <field name="name">nhiem.vu.tree</field>
        <field name="model">nhiem_vu</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ten_nhiem_vu"/>
                <field name="du_an_id"/>
                <field name="trang_thai"/>
                <field name="muc_uu_tien"/>
                <field name="han_chot"/>
                <field name="so_ngay_thuc_hien"/>
            </tree>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
<record id="view_nhiem_vu_search" model="ir.ui.view">
    <field name="name">nhiem.vu.search</field>
    <field name="model">nhiem_vu</field>
    <field name="arch" type="xml">
        <search>
            <field name="ten_nhiem_vu"/>
            <field name="du_an_id"/>
            <field name="trang_thai"/>
            <field name="muc_uu_tien"/>

            <filter string="Đang thực hiện" name="dang_thuc_hien"
                    domain="[('trang_thai','=','dang_thuc_hien')]"/>
            <filter string="Hoàn thành" name="hoan_thanh"
                    domain="[('trang_thai','=','hoan_thanh')]"/>
        </search>
    </field>
</record>






    <!-- ================= ACTION ================= -->
    <record id="action_nhiem_vu" model="ir.actions.act_window">
    <field name="name">Nhiệm vụ</field>
    <field name="res_model">nhiem_vu</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_nhiem_vu_search"/>
</record>


</odoo>
