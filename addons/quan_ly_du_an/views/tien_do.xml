<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_tien_do_form" model="ir.ui.view">
        <field name="name">tien.do.form</field>
        <field name="model">tien_do</field>
        <field name="arch" type="xml">
            <form string="Tiến độ công việc">
                <sheet>

                    <group>
                        <field name="nhiem_vu_id" required="1"/>
                        <field name="du_an_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="phan_tram_hoan_thanh"
                               widget="progressbar"
                               readonly="1"/>
                        <field name="trang_thai_du_an" readonly="1"/>
                    </group>

                    <group>
                        <field name="ghi_chu"/>
                    </group>

                    <group>
                        <field name="ngay_cap_nhat" readonly="1"/>
                        <field name="nguoi_cap_nhat_id" readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_tien_do_tree" model="ir.ui.view">
        <field name="name">tien.do.tree</field>
        <field name="model">tien_do</field>
        <field name="arch" type="xml">
            <tree string="Tiến độ công việc">
                <field name="nhiem_vu_id"/>
                <field name="du_an_id"/>
                <field name="phan_tram_hoan_thanh" widget="progressbar"/>
                <field name="ngay_cap_nhat"/>
                <field name="nguoi_cap_nhat_id"/>
            </tree>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_tien_do" model="ir.actions.act_window">
        <field name="name">Tiến độ công việc</field>
        <field name="res_model">tien_do</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================= MENU ================= -->
    <menuitem id="menu_tien_do"
              name="Tiến độ công việc"
              parent="menu_du_an_root"
              action="action_tien_do"/>

</odoo>
