
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_du_an_form" model="ir.ui.view">
        <field name="name">du.an.form</field>
        <field name="model">du_an</field>
        <field name="arch" type="xml">
            <form string="Dự án">
                <sheet>

                    <group>
                        <group>
                            <field name="ten_du_an"/>
                            <field name="ngan_sach"/>
                            <field name="muc_uu_tien"/>
                        </group>

                        <group>
                            <field name="ngay_bat_dau"/>
                            <field name="ngay_ket_thuc"/>
                            <field name="trang_thai"
                                   widget="statusbar"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="mo_ta"/>
                    </group>

                    <group>
                        <field name="tien_do_du_an" widget="progressbar" readonly="1"/>
                        <field name="so_luong_nhiem_vu" readonly="1"/>
                        <field name="so_luong_nhan_vien" readonly="1"/>
                    </group>

                    <notebook>

                        <!-- TAB NHÂN VIÊN -->
                        <page string="Nhân viên">
                            <field name="nhan_vien_ids" widget="many2many_tags"/>
                        </page>

                        <!-- TAB NHIỆM VỤ -->
                        <page string="Nhiệm vụ">
                            <field name="nhiem_vu_ids">
                                <tree>
                                    <field name="ten_nhiem_vu"/>
                                    <field name="trang_thai"/>
                                    <field name="muc_uu_tien"/>
                                    <field name="han_chot"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_du_an_tree" model="ir.ui.view">
        <field name="name">du.an.tree</field>
        <field name="model">du_an</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ten_du_an" string="Tên dự án"/>
                <field name="trang_thai" string="Trạng thái"/>
                <field name="muc_uu_tien" string="Mức ưu tiên"/>
                <field name="ngay_bat_dau" string="Ngày bắt đầu"/>
                <field name="ngay_ket_thuc" string="Ngày kết thúc"/>
                <field name="tien_do_du_an" string="Tiến độ (%)" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <record id="view_du_an_search" model="ir.ui.view">
        <field name="name">du.an.search</field>
        <field name="model">du_an</field>
        <field name="arch" type="xml">
            <search>
                <field name="ten_du_an"/>
                <field name="trang_thai"/>
                <field name="muc_uu_tien"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
            </search>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_du_an" model="ir.actions.act_window">
    <field name="name">Dự án</field>
    <field name="res_model">du_an</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_du_an_search"/>
</record>


</odoo>
