<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_cong_viec_form" model="ir.ui.view">
            <field name="name">cong.viec.form</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <form string="Công việc">
                    <sheet>
                        <group col="4" string="Thông tin chung">
                            <field name="ten_cong_viec"/>
                            <field name="nhan_vien_id"/>
                            <field name="trang_thai"/>
                            <field name="han_hoan_thanh"/>
                            <field name="tien_do" widget="percentage"/>
                            <field name="tien_do_tu_dong" widget="percentage" readonly="1" 
                                   attrs="{'invisible': [('cong_viec_con_ids', '=', [])]}"
                                   help="Tiến độ tự động tính từ công việc con"/>
                            <field name="ngay_bat_dau"/>
                            <field name="ngay_ket_thuc"/>
                            <field name="mo_ta"/>
                        </group>
                        
                        <group col="2" string="Liên kết dự án">
                            <field name="du_an_id"/>
                            <field name="nhiem_vu_id"/>
                        </group>

                        <notebook>
                            <page string="Công việc con">
                                <field name="cong_viec_con_ids"/>
                            </page>
                            <page string="Ghi nhận thời gian">
                                <field name="ghi_nhan_thoi_gian_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_cong_viec_tree" model="ir.ui.view">
            <field name="name">cong.viec.tree</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <tree string="Công việc">
                    <field name="ten_cong_viec"/>
                    <field name="du_an_id"/>
                    <field name="nhiem_vu_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="trang_thai"/>
                    <field name="han_hoan_thanh"/>
                    <field name="tien_do"/>
                    <field name="ngay_bat_dau"/>
                    <field name="ngay_ket_thuc"/>
                </tree>
            </field>
        </record>

        <!-- SEARCH VIEW (SỬA LỖI JS: chỉ để field “an toàn”) -->
        <record id="cong_viec_search" model="ir.ui.view">
            <field name="name">cong.viec.search</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ten_cong_viec"/>
                    <field name="du_an_id"/>
                    <field name="nhiem_vu_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="trang_thai"/>
                    <field name="ngay_bat_dau"/>
                    <field name="ngay_ket_thuc"/>
                    <field name="han_hoan_thanh"/>

                    <!-- filter mẫu -->
                    <filter string="Đang làm" name="dang_lam" domain="[('trang_thai','=','dang_thuc_hien')]"/>
                    <filter string="Hoàn thành" name="hoan_thanh" domain="[('trang_thai','=','hoan_thanh')]"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_cong_viec" model="ir.actions.act_window">
            <field name="name">Công việc</field>
            <field name="res_model">cong_viec</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="cong_viec_search"/>
        </record>

    </data>
</odoo>
